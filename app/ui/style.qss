* {
    font-family: "Segoe UI", "Vazirmatn", sans-serif;
    color: #E6E6F0;
}

QWidget#MainWindow, QMainWindow {
    background-color: #0E0F14;
}

QFrame#Card {
    background-color: #16181F;
    border: 1px solid #23262F;
    border-radius: 14px;
}

QLabel#Title {
    font-size: 22px;
    font-weight: 800;
    color: #FFFFFF;
}

QLabel#Subtitle {
    font-size: 12px;
    color: #8A8DA0;
}

QLabel.SectionLabel {
    font-size: 13px;
    font-weight: 600;
    color: #B9BCD0;
}

QLabel.ValueLabel {
    font-size: 12px;
    color: #00E5A8;
    font-weight: 700;
}

QPushButton#PowerButton {
    background-color: #1B1E27;
    border: 2px solid #00E5A8;
    border-radius: 28px;
    color: #00E5A8;
    font-weight: 800;
    font-size: 14px;
}
QPushButton#PowerButton:checked {
    background-color: #00E5A8;
    color: #0E0F14;
}
QPushButton#PowerButton:hover {
    border-color: #33F0BE;
}

QPushButton {
    background-color: #1B1E27;
    border: 1px solid #2C2F3A;
    border-radius: 8px;
    padding: 8px 14px;
    color: #E6E6F0;
}
QPushButton:hover {
    background-color: #23262F;
    border-color: #7C5CFF;
}
QPushButton:pressed {
    background-color: #14151B;
}

QComboBox {
    background-color: #1B1E27;
    border: 1px solid #2C2F3A;
    border-radius: 8px;
    padding: 6px 10px;
}
QComboBox QAbstractItemView {
    background-color: #1B1E27;
    selection-background-color: #7C5CFF;
    color: #E6E6F0;
    border: 1px solid #2C2F3A;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #23262F;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7C5CFF, stop:1 #00E5A8);
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 2px solid #7C5CFF;
}

QSlider::groove:vertical {
    width: 6px;
    background: #23262F;
    border-radius: 3px;
}
QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:1, x2:0, y2:0,
        stop:0 #7C5CFF, stop:1 #00E5A8);
    border-radius: 3px;
}
QSlider::handle:vertical {
    background: #FFFFFF;
    height: 14px;
    width: 14px;
    margin: 0 -4px;
    border-radius: 7px;
    border: 2px solid #7C5CFF;
}

QCheckBox {
    spacing: 8px;
    color: #E6E6F0;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #2C2F3A;
    background: #1B1E27;
}
QCheckBox::indicator:checked {
    background: #00E5A8;
    border-color: #00E5A8;
}

QProgressBar {
    background-color: #1B1E27;
    border: none;
    border-radius: 5px;
    height: 10px;
}
QProgressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00E5A8, stop:0.7 #7C5CFF, stop:1 #FF4D6D);
}

QListWidget {
    background-color: #1B1E27;
    border: 1px solid #2C2F3A;
    border-radius: 8px;
}

QStatusBar {
    background-color: #0E0F14;
    color: #8A8DA0;
}
